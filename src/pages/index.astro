---
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.jsx';
import { getImage } from 'astro:assets';

import statusscoutRaw from '../imgs/statusscout.png';
import starguessrRaw from '../imgs/starguessr.png';
import tram4Raw from '../imgs/tram4.jpg';
import foerderhausRaw from '../imgs/foerderhaus.svg';
import wwebRaw from '../imgs/wweb.png';
import puzzlerRaw from '../imgs/puzzler.png';
import vinceniusRaw from '../imgs/vincenius.svg';
import playlistRaw from '../imgs/playlist.png';
import workoutRaw from '../imgs/workout.png';
import sponsorNinjaRaw from '../imgs/sponsor-ninja.png';

const [starguessr, statusscout, tram4, wweb, puzzler, playlist, workout, sponsorNinja] =
  await Promise.all([
    getImage({ src: starguessrRaw, width: 800, format: 'webp' }),
    getImage({ src: statusscoutRaw, width: 800, format: 'webp' }),
    getImage({ src: tram4Raw, width: 800, format: 'webp' }),
    getImage({ src: wwebRaw, width: 60, format: 'webp' }),
    getImage({ src: puzzlerRaw, width: 60, format: 'webp' }),
    getImage({ src: playlistRaw, width: 60, format: 'webp' }),
    getImage({ src: workoutRaw, width: 80, format: 'webp' }),
    getImage({ src: sponsorNinjaRaw, width: 60, format: 'webp' }),
  ]);

const images = {
  starguessr: starguessr.src,
  statusscout: statusscout.src,
  tram4: tram4.src,
  foerderhaus: foerderhausRaw.src,
  wweb: wweb.src,
  puzzler: puzzler.src,
  vincenius: vinceniusRaw.src,
  playlist: playlist.src,
  workout: workout.src,
  sponsorNinja: sponsorNinja.src,
};
---

<Layout>
  <Home images={images} activePath={Astro.url.pathname} />
</Layout>
