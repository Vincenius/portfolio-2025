---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Card } from '@mantine/core';
import Layout from '../../layouts/Layout.astro';
import BlogDetail from '../../components/BlogDetail.jsx';
import styles from '@/styles/Blog.module.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { postId: post.id },
  }));
}

const { postId } = Astro.props;
const post = await getEntry('blog', postId);

if (!post) {
  return Astro.redirect('/blog');
}

const postContent = {
  data: {
    headline: post.data.headline,
    date: post.data.date,
    previewText: post.data.previewText,
  },
  body: post.body,
};
---

<Layout>
  <BlogDetail post={postContent} activePath={Astro.url.pathname} />
  {post.data.image && (
    <div style={{marginTop: '1rem'}}>
      <Card className={styles.bubble} radius="lg" withBorder shadow="sm" p="lg">
        <Card.Section>
          <Image 
            src={post.data.image} 
            alt={post.data.headline || 'Blog post image'} 
            className={styles.bubbleImage}
            widths={[400, 800, 1200]}
            sizes="(max-width: 800px) 400px, 800px"
          />
        </Card.Section>
      </Card>
    </div>
  )}
</Layout>

